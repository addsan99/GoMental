{
  "name": "gomental-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate-themes": "node scripts/generate-vscode-themes.mjs",
    "dev": "npm run generate-themes && vite",
    "build": "npm run generate-themes && vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "android:add": "cap add android",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@mdxeditor/editor": "^4.0.4",
    "@wailsio/runtime": "latest",
    "d3-force-3d": "^3.0.6",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lexical": "^0.48.0",
    "mermaid": "^11.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-3d": "^1.29.1",
    "sigma": "^3.0.3",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.32.6": true
  }
}
